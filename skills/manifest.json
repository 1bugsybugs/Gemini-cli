      "outputs": ["file_map", "repo_summary", "suggested_next_steps"],
      "risk": "low",
      "approval_required": false,
      "provider_or_mcp": "github_or_filesystem",
      "status": "planned"
    },
    {
      "name": "plan_project",
      "description": "Creates a safe project plan before any files are written.",
